# Database (host port 15432 — Windows may exclude 5141-5940)
DATABASE_URL=postgresql+asyncpg://aicms:aicms_dev_secret@localhost:15432/aicms

# Redis (host port 16001 — 6379/16379 blocked by Windows Hyper-V exclusions)
REDIS_URL=redis://localhost:16001/0

# Object storage: local (dev) or s3 (MinIO/real S3)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=.data/docs
# object storage (S3-compatible) — only used when STORAGE_BACKEND=s3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret
MINIO_BUCKET=aicms-docs
MINIO_USE_SSL=false

# Auth
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRE_MINUTES=60
ALLOW_LOCAL_LOGIN=true

# OIDC (production)
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# AI provider: mock (deterministic, no network) or openai (any OpenAI-compatible endpoint)
AI_PROVIDER=mock
# queue = AI review runs on the RQ worker; inline = runs inside the request (tests/dev)
REVIEW_MODE=queue

# OpenAI-compatible AI settings (used when AI_PROVIDER=openai)
# Works with OpenAI, an Azure/proxy gateway, Ollama (/v1), vLLM, LM Studio, etc.
AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.0
AI_MAX_TOKENS=2000
AI_TIMEOUT_SECONDS=60
AI_MAX_DOCUMENTS=10
AI_MAX_DOCUMENT_CHARS=12000
# Recorded on every review; bump when the prompt or ruleset changes.
AI_PROMPT_VERSION=v1
AI_RULESET_VERSION=v1
# Legacy aliases (still read if AI_API_KEY/AI_MODEL are unset)
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Logging
LOG_LEVEL=DEBUG
